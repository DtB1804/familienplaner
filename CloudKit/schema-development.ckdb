DEFINE SCHEMA

    RECORD TYPE CD_CDEvent (
        CD_createdAt                  TIMESTAMP,
        CD_createdByMemberID          STRING,
        CD_deletedAt                  TIMESTAMP,
        CD_endAt                      TIMESTAMP,
        CD_entityName                 STRING,
        CD_exceptionDatesJSON         STRING,
        CD_exceptionDatesJSON_ckAsset ASSET,
        CD_externalIdentifier         STRING,
        CD_externalIdentifier_ckAsset ASSET,
        CD_household                  STRING,
        CD_id                         STRING,
        CD_isAllDay                   INT64,
        CD_kindRaw                    STRING,
        CD_kindRaw_ckAsset            ASSET,
        CD_latitude                   DOUBLE,
        CD_locationName               STRING,
        CD_locationName_ckAsset       ASSET,
        CD_longitude                  DOUBLE,
        CD_notes                      STRING,
        CD_notes_ckAsset              ASSET,
        CD_originRaw                  STRING,
        CD_originRaw_ckAsset          ASSET,
        CD_recurrenceRule             STRING,
        CD_recurrenceRule_ckAsset     ASSET,
        CD_requiredRolesRaw           STRING,
        CD_requiredRolesRaw_ckAsset   ASSET,
        CD_seriesParentID             STRING,
        CD_sourceCalendarSourceID     STRING,
        CD_startAt                    TIMESTAMP,
        CD_tag                        STRING,
        CD_timeZoneIdentifier         STRING,
        CD_timeZoneIdentifier_ckAsset ASSET,
        CD_title                      STRING,
        CD_title_ckAsset              ASSET,
        CD_travelBufferAfter          INT64,
        CD_travelBufferBefore         INT64,
        CD_updatedAt                  TIMESTAMP,
        CD_visibilityRaw              STRING,
        CD_visibilityRaw_ckAsset      ASSET,
        "___createTime"               TIMESTAMP,
        "___createdBy"                REFERENCE,
        "___etag"                     STRING,
        "___modTime"                  TIMESTAMP,
        "___modifiedBy"               REFERENCE,
        "___recordID"                 REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_CDEventParticipation (
        CD_claimedAt         TIMESTAMP,
        CD_createdAt         TIMESTAMP,
        CD_entityName        STRING,
        CD_event             STRING,
        CD_id                STRING,
        CD_member            STRING,
        CD_note              STRING,
        CD_note_ckAsset      ASSET,
        CD_roleRaw           STRING,
        CD_roleRaw_ckAsset   ASSET,
        CD_statusRaw         STRING,
        CD_statusRaw_ckAsset ASSET,
        CD_updatedAt         TIMESTAMP,
        "___createTime"      TIMESTAMP,
        "___createdBy"       REFERENCE,
        "___etag"            STRING,
        "___modTime"         TIMESTAMP,
        "___modifiedBy"      REFERENCE,
        "___recordID"        REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_CDHousehold (
        CD_childrenSeeAdultTitles     INT64,
        CD_createdAt                  TIMESTAMP,
        CD_entityName                 STRING,
        CD_id                         STRING,
        CD_name                       STRING,
        CD_name_ckAsset               ASSET,
        CD_ownerMemberID              STRING,
        CD_schemaVersion              INT64,
        CD_timeZoneIdentifier         STRING,
        CD_timeZoneIdentifier_ckAsset ASSET,
        CD_updatedAt                  TIMESTAMP,
        CD_weekStartsOn               INT64,
        "___createTime"               TIMESTAMP,
        "___createdBy"                REFERENCE,
        "___etag"                     STRING,
        "___modTime"                  TIMESTAMP,
        "___modifiedBy"               REFERENCE,
        "___recordID"                 REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_CDMember (
        CD_accountKindRaw                 STRING,
        CD_accountKindRaw_ckAsset         ASSET,
        CD_avatarData                     BYTES,
        CD_avatarData_ckAsset             ASSET,
        CD_birthdate                      TIMESTAMP,
        CD_cloudKitUserRecordName         STRING,
        CD_cloudKitUserRecordName_ckAsset ASSET,
        CD_colorToken                     STRING,
        CD_colorToken_ckAsset             ASSET,
        CD_createdAt                      TIMESTAMP,
        CD_displayName                    STRING,
        CD_displayName_ckAsset            ASSET,
        CD_entityName                     STRING,
        CD_household                      STRING,
        CD_id                             STRING,
        CD_isActive                       INT64,
        CD_roleRaw                        STRING,
        CD_roleRaw_ckAsset                ASSET,
        CD_shortName                      STRING,
        CD_shortName_ckAsset              ASSET,
        CD_sortIndex                      INT64,
        CD_updatedAt                      TIMESTAMP,
        "___createTime"                   TIMESTAMP,
        "___createdBy"                    REFERENCE,
        "___etag"                         STRING,
        "___modTime"                      TIMESTAMP,
        "___modifiedBy"                   REFERENCE,
        "___recordID"                     REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_CDSuggestionDraft (
        CD_createdAt                 TIMESTAMP,
        CD_createdByMemberID         STRING,
        CD_entityName                STRING,
        CD_extractedPayload          BYTES,
        CD_extractedPayload_ckAsset  ASSET,
        CD_household                 STRING,
        CD_id                        STRING,
        CD_modelConfidence           DOUBLE,
        CD_resultingEventID          STRING,
        CD_reviewedAt                TIMESTAMP,
        CD_reviewedByMemberID        STRING,
        CD_sourceAsset               BYTES,
        CD_sourceAsset_ckAsset       ASSET,
        CD_sourceKindRaw             STRING,
        CD_sourceKindRaw_ckAsset     ASSET,
        CD_sourceTextExcerpt         STRING,
        CD_sourceTextExcerpt_ckAsset ASSET,
        CD_statusRaw                 STRING,
        CD_statusRaw_ckAsset         ASSET,
        CD_updatedAt                 TIMESTAMP,
        "___createTime"              TIMESTAMP,
        "___createdBy"               REFERENCE,
        "___etag"                    STRING,
        "___modTime"                 TIMESTAMP,
        "___modifiedBy"              REFERENCE,
        "___recordID"                REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_CDTag (
        CD_colorToken         STRING,
        CD_colorToken_ckAsset ASSET,
        CD_createdAt          TIMESTAMP,
        CD_entityName         STRING,
        CD_household          STRING,
        CD_id                 STRING,
        CD_isSystem           INT64,
        CD_name               STRING,
        CD_name_ckAsset       ASSET,
        CD_sortIndex          INT64,
        CD_symbolName         STRING,
        CD_symbolName_ckAsset ASSET,
        CD_updatedAt          TIMESTAMP,
        "___createTime"       TIMESTAMP,
        "___createdBy"        REFERENCE,
        "___etag"             STRING,
        "___modTime"          TIMESTAMP,
        "___modifiedBy"       REFERENCE,
        "___recordID"         REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
