<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>de_DE</string>
	<key>CFBundleDisplayName</key>
	<string>Family Planner</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Nur Standard-Verschlüsselung von iOS (HTTPS/CloudKit): erspart die
	     Exportfrage bei jedem TestFlight-Upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- iPad: alle Ausrichtungen, sonst lehnt App Store Connect den Upload für
	     iPad-Multitasking ab. Das iPhone bleibt im Hochformat. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Automatic</string>

	<!-- Berechtigungstexte. Diese Sätze liest die Familie, nicht Apple.
	     Sie erklären den Nutzen, nicht die Technik. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>de.barg.familienplaner</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>familyplanner</string>
			</array>
		</dict>
	</array>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Family Planner liest die Kalender, die du auswählst, und zeigt deren Termine der Familie – mit Titel oder nur als „Belegt“. Auf Wunsch trägt die App Familientermine in einen eigenen Kalender „Family Planner“ ein.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Family Planner trägt Familientermine in einen eigenen Kalender „Family Planner“ ein. Bestehende Termine werden dabei nicht gelesen.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Family Planner liest nur das Foto oder den Screenshot, den du auswählst, und erkennt darin Termine. Die Auswertung geschieht auf dem Gerät.</string>
	<key>NSCameraUsageDescription</key>
	<string>Family Planner fotografiert Aushänge und Elternbriefe, um darin Termine zu erkennen. Die Auswertung geschieht auf dem Gerät.</string>

	<!-- Ohne diesen Schlüssel öffnet iOS Einladungslinks nicht in der App. -->
	<key>CKSharingSupported</key>
	<true/>

	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>de.barg.familienplaner.calendarRefresh</string>
	</array>
</dict>
</plist>
